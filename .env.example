# IC CRM Environment Configuration Example

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/iccrm_db?schema=public"

# Authentication
JWT_SECRET="your-production-secure-jwt-secret-key-at-least-32-chars"
JWT_EXPIRES_IN="7d"

# Frontend Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Redis Cache Connection (Optional)
REDIS_URL="redis://localhost:6379"
